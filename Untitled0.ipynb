                excerpt: "國際能源署（IEA）指出中東危機使化石燃料昂貴，反倒促使歐、亞、拉美加快補貼電氣化。預期今年電動車銷量達 2,300 萬輛，佔新車 30%。",
                concepts: "IEA、油價飆漲、電動車、補貼延長",
                date: "2026-05-20",
                badge: "電氣化"
            }
        ];

        // Global Page State
        let currentTab = 'semi';

        // Initialize App
        window.onload = function() {
            lucide.createIcons();
            renderLibrary(completeLibrary);
            simulateChain(1); // Default Chain Reaction
        };

        // DOM dynamic rendering for reference library
        function renderLibrary(items) {
            const grid = document.getElementById('library-grid');
            grid.innerHTML = '';

            document.getElementById('matched-count').innerText = items.length;

            if (items.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500 text-xs">
                        找不到符合過濾條件的情報文獻。請嘗試其他搜尋關鍵字或分類。
                    </div>
                `;
                return;
            }

            items.forEach(item => {
                let badgeColor = '';
                switch (item.category) {
                    case 'semi':
                        badgeColor = 'bg-indigo-500/10 text-indigo-300 border-indigo-500/20';
                        break;
                    case 'macro':
                        badgeColor = 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20';
                        break;
                    case 'energy':
                        badgeColor = 'bg-amber-500/10 text-amber-300 border-amber-500/20';
                        break;
                    case 'fluorine':
                        badgeColor = 'bg-rose-500/10 text-rose-300 border-rose-500/20';
                        break;
                    case 'satellite':
                        badgeColor = 'bg-sky-500/10 text-sky-300 border-sky-500/20';
                        break;
                    default:
                        badgeColor = 'bg-slate-500/10 text-slate-300 border-slate-500/20';
                }

                const cardHtml = `
                    <div class="bg-slate-950/80 border border-slate-850 p-4 rounded-xl flex flex-col justify-between hover:border-slate-700 transition-all group glow-border">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[9px] px-2 py-0.5 rounded font-bold border ${badgeColor}">
                                    ${item.category === 'semi' ? '半導體設備' : item.category === 'macro' ? '總經與政策' : item.category === 'energy' ? '綠能與石化' : item.category === 'fluorine' ? '去氟特材液冷' : '低軌衛星航太'}
                                </span>
                                <span class="text-[9px] font-black text-slate-500 tracking-wider">${item.badge}</span>
                            </div>
                            <h4 class="text-xs md:text-sm font-bold text-slate-100 group-hover:text-indigo-400 transition-colors line-clamp-2">
                                ${item.title}
                            </h4>
                            <p class="text-[11px] text-slate-400 leading-relaxed line-clamp-3">
                                ${item.excerpt}
                            </p>
                        </div>
                        <div class="pt-3 mt-3 border-t border-slate-800/60 flex items-center justify-between">
                            <div class="space-y-0.5">
                                <span class="text-[10px] text-slate-500 block">${item.source}</span>
                                <span class="text-[9px] text-slate-600 block">${item.date}</span>
                            </div>
                            <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[10px] text-indigo-400 hover:text-indigo-300 font-bold transition-all shrink-0">
                                連結原文 <i data-lucide="external-link" class="w-3 h-3"></i>
                            </a>
                        </div>
                    </div>
                `;
                grid.insertAdjacentHTML('beforeend', cardHtml);
            });
            lucide.createIcons();
        }

        // Library filter logic
        function filterLibrary() {
            const query = document.getElementById('library-search').value.toLowerCase();
            const category = document.getElementById('library-filter').value;

            const filtered = completeLibrary.filter(item => {
                const matchText = item.title.toLowerCase().includes(query) || 
                                  item.excerpt.toLowerCase().includes(query) || 
                                  item.concepts.toLowerCase().includes(query) || 
                                  item.source.toLowerCase().includes(query);
                const matchCat = category === 'all' || item.category === category;
                return matchText && matchCat;
            });

            renderLibrary(filtered);
        }

        // Tab Swapping
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow');
                btn.classList.add('text-slate-400', 'hover:text-white');
            });

            document.getElementById(`content-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.remove('text-slate-400', 'hover:text-white');
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow');
            currentTab = tabId;
        }

        // Sandbox Chain Reaction Simulator
        function simulateChain(chainId) {
            // Reset active button states
            document.querySelectorAll('.chain-btn').forEach(btn => {
                btn.classList.remove('border-indigo-500', 'border-amber-500', 'border-rose-500', 'bg-indigo-950/30', 'bg-amber-950/30', 'bg-rose-950/30');
            });

            const node1 = document.getElementById('node-1');
            const node2 = document.getElementById('node-2');
            const node3 = document.getElementById('node-3');
            const arrow1 = document.getElementById('node-arrow-1');
            const arrow2 = document.getElementById('node-arrow-2');
            const commBox = document.getElementById('commentary-box');

            // Reset node active colors
            node1.className = "w-full md:w-1/4 p-3 rounded-xl border border-slate-800 bg-slate-900/50 text-xs font-bold text-slate-400 transition-all duration-300";
            node2.className = "w-full md:w-1/4 p-3 rounded-xl border border-slate-800 bg-slate-900/50 text-xs font-bold text-slate-400 transition-all duration-300";
            node3.className = "w-full md:w-1/4 p-3 rounded-xl border border-slate-800 bg-slate-900/50 text-xs font-bold text-slate-400 transition-all duration-300";
            arrow1.className = "text-slate-700 font-black hidden md:block transition-colors";
            arrow2.className = "text-slate-700 font-black hidden md:block transition-colors";

            if (chainId === 1) {
                document.getElementById('chain-btn-1').classList.add('border-indigo-500', 'bg-indigo-950/30');
                
                node1.innerText = "美債高利率倒掛 293點";
                node1.className = "w-full md:w-1/4 p-3 rounded-xl border border-indigo-500/80 bg-indigo-950/40 text-xs font-bold text-indigo-300 transition-all duration-300";
                
                node2.innerText = "外資匯出 / 亞幣阻貶";
                node2.className = "w-full md:w-1/4 p-3 rounded-xl border border-indigo-500/60 bg-indigo-950/20 text-xs font-bold text-indigo-300 transition-all duration-300";
                
                node3.innerText = "新台幣硬守 31.6 防線";
                node3.className = "w-full md:w-1/4 p-3 rounded-xl border border-indigo-500/40 bg-indigo-950/10 text-xs font-bold text-indigo-300 transition-all duration-300";

                arrow1.className = "text-indigo-500 font-black hidden md:block transition-colors";
                arrow2.className = "text-indigo-500 font-black hidden md:block transition-colors";

                commBox.innerHTML = `
                    <div class="flex items-center gap-1.5 text-xs font-bold text-indigo-400">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span>專家評估：高利差套利外流</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        美債高利率使套利誘因極大，外資連續12個月減持陸債，並從台北匯市流出。台灣央行一改放任態度，強勢進場精細調節，硬守31.643元，主要是防止因急速貶值引發「輸入型能源通膨」，加劇台灣內部 K型經濟民生產業之痛苦指數。
                    </p>
                `;
            } else if (chainId === 2) {
                document.getElementById('chain-btn-2').classList.add('border-amber-500', 'bg-amber-950/30');

                node1.innerText = "長鑫存儲月產破30萬片";
                node1.className = "w-full md:w-1/4 p-3 rounded-xl border border-amber-500/80 bg-amber-950/40 text-xs font-bold text-amber-300 transition-all duration-300";
                
                node2.innerText = "2027 DRAM 過剩疑慮";
                node2.className = "w-full md:w-1/4 p-3 rounded-xl border border-amber-500/60 bg-amber-950/20 text-xs font-bold text-amber-300 transition-all duration-300";
                
                node3.innerText = "台股記憶體類股踩踏跌停";
                node3.className = "w-full md:w-1/4 p-3 rounded-xl border border-amber-500/40 bg-amber-950/10 text-xs font-bold text-amber-300 transition-all duration-300";

                arrow1.className = "text-amber-500 font-black hidden md:block transition-colors";
                arrow2.className = "text-amber-500 font-black hidden md:block transition-colors";

                commBox.innerHTML = `
                    <div class="flex items-center gap-1.5 text-xs font-bold text-amber-400">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span>專家評估：DRAM週期反轉恐慌</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        中國長鑫存儲 DDR5 規格升至 8000MT/s、產量急劇釋放。加上 Cerebras 晶圓級運算架構威脅，使 HBM 的壟斷護城河出現疑慮。投資人對「AI 記憶體需求觸頂」神經緊繃，引爆南亞科、華邦電與群聯的恐慌性踩踏殺盤。
                    </p>
                `;
            } else if (chainId === 3) {
                document.getElementById('chain-btn-3').classList.add('border-rose-500', 'bg-rose-950/30');

                node1.innerText = "單機櫃功耗直奔 1.6MW";
                node1.className = "w-full md:w-1/4 p-3 rounded-xl border border-rose-500/80 bg-rose-950/40 text-xs font-bold text-rose-300 transition-all duration-300";
                
                node2.innerText = "歐盟 PFAS 特化禁令 REACH";
                node2.className = "w-full md:w-1/4 p-3 rounded-xl border border-rose-500/60 bg-rose-950/20 text-xs font-bold text-rose-300 transition-all duration-300";
                
                node3.innerText = "雙相直接液冷 DLC 技術落地";
                node3.className = "w-full md:w-1/4 p-3 rounded-xl border border-rose-500/40 bg-rose-950/10 text-xs font-bold text-rose-300 transition-all duration-300";

                arrow1.className = "text-rose-500 font-black hidden md:block transition-colors";
                arrow2.className = "text-rose-500 font-black hidden md:block transition-colors";

                commBox.innerHTML = `
                    <div class="flex items-center gap-1.5 text-xs font-bold text-rose-400">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span>專家評估：散熱極限與特化去氟</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        功耗暴增 200 倍逼退傳統高速銅線，全面推動光電整合（COUPE/CPO）。而歐盟 PFAS 強制退場令，使得傳統含氟冷卻液瀕臨禁制。這將極大地推升不含 PFAS 的無氟雙相直接液冷（DLC）特化化學品之戰略主權與利潤空間。
                    </p>
                `;
            }
            lucide.createIcons();
        }

        // Toast trigger helper
        function showToast(title, message) {
            const box = document.getElementById('toast-box');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-message').innerText = message;

            box.classList.remove('hidden');
            setTimeout(() => {
                box.classList.add('hidden');
            }, 4500);
        }

        // Open/Close Modal
        function openExportModal() {
            document.getElementById('export-modal').classList.remove('hidden');
        }

        // Close Modal
        function closeExportModal() {
            document.getElementById('export-modal').classList.add('hidden');
            document.getElementById('modal-download-progress').classList.add('hidden');
            document.getElementById('download-progress-bar').style.width = '0%';
            document.getElementById('download-pct').innerText = '0%';
        }

        // Simulate Download Progress with high reliability
        function simulateReportDownload(filename) {
            const progress = document.getElementById('modal-download-progress');
            const bar = document.getElementById('download-progress-bar');
            const lbl = document.getElementById('download-lbl');
            const pct = document.getElementById('download-pct');

            progress.classList.remove('hidden');
            bar.style.width = '0%';

            let percentage = 0;
            const timer = setInterval(() => {
                percentage += 10;
                bar.style.width = `${percentage}%`;
                pct.innerText = `${percentage}%`;

                if (percentage === 30) {
                    lbl.innerText = "正在交叉比對 30 篇全球趨勢文獻...";
                } else if (percentage === 60) {
                    lbl.innerText = "正在彙整台積電2nm及無氟冷卻液架構...";
                } else if (percentage === 90) {
                    lbl.innerText = "寫入情報專家 W21 董事會安全密鑰...";
                } else if (percentage === 100) {
                    clearInterval(timer);
                    lbl.innerText = `下載成功：${filename}`;
                    setTimeout(() => {
                        closeExportModal();
                        showToast("匯出成功", `${filename} 已儲存至您本地下載路徑。`);
                    }, 1200);
                }
            }, 250);
        }
    </script>
</body>
</html>
